# Server Configuration
PORT=3001
JWT_SECRET=your_jwt_secret_here_change_in_production
CLIENT_ORIGIN=http://localhost:5173

# Client Configuration
VITE_SERVER_URL=http://localhost:3001

# Socket.IO Transports (comma-separated)
# Local dev: websocket,polling (both work)
# Note: On serverless platforms like Vercel, polling transport sessions do not
# persist across invocations, so real-time chat features will not work.
# Use a single-instance host (Railway, Render, Fly.io, VPS) for production.
SOCKET_TRANSPORTS=websocket,polling
VITE_SOCKET_TRANSPORTS=websocket,polling
